# taskq-api environment configuration (SPEC.md §5.1)
#
# Copy to .env and adjust for your environment. All 12 TASKQ_* variables
# MUST be declared here (SPEC acceptance #26).

# ── Database (FR-06 / NFR-04) ──────────────────────────────────────────────
# Production DSN; the password MUST NOT appear in logs (NFR-04).
TASKQ_DB_URL=sqlite:///./taskq.db
TASKQ_DB_POOL_SIZE=5

# ── Task execution (FR-08) ────────────────────────────────────────────────
# Single-task subprocess timeout (seconds).
TASKQ_TASK_TIMEOUT=10.0
# Background worker concurrency cap.
TASKQ_MAX_CONCURRENT=8
# Graceful drain budget on shutdown (seconds).
TASKQ_DRAIN_TIMEOUT=30.0

# ── Rate limiting (FR-05) ─────────────────────────────────────────────────
# Per-token bucket capacity.
TASKQ_RATE_BURST=20
# Per-token refill rate (tokens / second).
TASKQ_RATE_PER_SEC=5.0

# ── Network (NFR-02: defaults refuse external exposure) ───────────────────
TASKQ_HOST=127.0.0.1
TASKQ_PORT=8000

# ── Security (NFR-02: CORS defaults deny-all) ─────────────────────────────
# Comma-separated list of allowed origins; empty = deny all.
TASKQ_CORS_ORIGINS=

# ── Observability ─────────────────────────────────────────────────────────
TASKQ_LOG_LEVEL=INFO
TASKQ_LOG_FORMAT=json