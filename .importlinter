[importlinter]
root_package = taskq_api
include_external_packages = true

[importlinter:contract:layer-ordering]
name = Layer ordering
type = layers
layers =
    taskq_api.api
    taskq_api.service
    taskq_api.repository
    taskq_api.models

[importlinter:contract:sqlalchemy-containment]
name = SQLAlchemy containment
type = forbidden
source_modules =
    taskq_api
    taskq_api.api
    taskq_api.service
    taskq_api.repository
    taskq_api.models
    taskq_api.app
forbidden_modules =
    sqlalchemy
ignore_imports =
    taskq_api.repository.session -> sqlalchemy
    taskq_api.models.orm -> sqlalchemy

[importlinter:contract:config-errors-independence]
name = Config and errors independence
type = independence
modules =
    taskq_api.config
    taskq_api.errors
